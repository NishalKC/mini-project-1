<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class="flex mb-3 justify-end gap-1 ">
            <a href="/profile" class="flex justify-centre gap-3">
            <img style="border-radius: 50%;"  class="w-13 h-13 border-3 border-zinc-400" src="/images/uploads/<%= user.profilepic%>" alt="">
        </a>
        </div>
        
        <a class="text-red-500 mb-5 inline-block" href="/profile">Back to profile</a>
        <h1 class="text-blue-500 text-3xl">All posts</h1>
        
        <div class="mt-6 w-full ">
            <% posts.forEach((post) => { %>

                <div class="postcontainer w-1/4 p-4 rounded-md mb-5 bg-zinc-700">

                    <a class="flex gap-3 text-blue-500"  href="/profile/<%= post.user ? post.user._id : '#' %>">

                        <img class="w-8 h-8 rounded-full"
                            src="/images/uploads/<%= post.user ? post.user.profilepic : 'default.png' %>">

                        <h4>@<%= post.user ? post.user.username : "Deleted User" %></h4>

                    </a>
                    <div class="mt-3 block">

                        <p class=" text-zinc-3 "><%= post.content %></p>
                        
                        <small class="mt-1 inline-block" ><%= post.likes.length %> likes</small>
                        
                    </div>
                        <a class="text-blue-500" href="/likes/<%= post._id %>">
                            <%= (post.likes || []).some(id =>
                            id.toString() === user._id.toString()
                            ) ? "Unlike" : "Like" %>
                        </a>

                </div>

            <% }) %>
        </div>
            
    </div>
</body>
</html>