<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class=" flex w-full justify-end">
            <a href="/logout" class="bg-red-500 mb-4 text-sm px-5 py-3 rounded-md inline-block">Logout</a>
        </div>
        <h1 class="text-3xl mb-3 "> <span class="font-light">Hello</span> , <%=post.user.name %></h1>
        <h5>you can edit your post</h5>
        <form action="/update/<%= post._id%>" method="post">
            <textarea placeholder="What's on your mind?"  name="content" class=" block resize-none bg-transparent border-3 border-zinc-500 mt-4 w-1/3 outline-none p-3 rounded-md"> <%= post.content%> </textarea>
            <input type="submit" class="px-5 py-3 bg-yellow-500 block mt-3 w-40 rounded-md" value="update post">
        </form>

    </div>
</body>
</html>