<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
                
    <div class="messages inline-block w-full h-screen  bg-zinc-900 rounded-md p-10">
        <a href="/profile" class="text-red-500 mb-6 inline-block">Go back</a>
            <h1 class="text-3xl text-blue-500 py-4">Friends</h1>
            <%friends.forEach((friend) => { %>
                
                <div class=" md-6 mt-3 bg-zinc-700 w-1/3 px-10 py-4 rounded-md ">
                    <div class="py-4 flex gap-5" >

                        <img style="border-radius: 50%;" class="h-13 w-13 object-cover " src="/images/uploads/<%= friend.profilepic %>" alt="">
                        <h1 style="transform: translateY(9px);" class="text-red-500 text-2xl"><%= friend.name%></h1>
                    </div>
                    <h1 class="text-blue-500 mb-3">@<%= friend.username%></h1>
                    <a href="/profile/<%= friend._id%>"> Visit profile</a>      
                </div>
            <% })%>
    </div>     
</body>
</html>