<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <span class="mb-4 inline-block">haven't any  account?  <a href="/" class="text-zinc-400"> create account</a></span>
        <h1 class="text-3xl mb-7 ">login Aaccount</h1>
        <form action="/login" method="post">
            <input type="email" placeholder="email" name="email" class="p-3 mt-5 outline-none bg-transparent border-1 border-zinc-800  rounded-md  gap-4">
            <input type="password" placeholder="password" name="password" class="p-3 mt-5 outline-none bg-transparent border-1 border-zinc-800  rounded-md  gap-4">
            <input type="submit" value="login Aaccount" class="py-3 px-5  bg-blue-500 rounded-md">
        </form>
    </div>
</body>
</html>