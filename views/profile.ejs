<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class=" flex w-full justify-end">
            <a href="/logout" class="bg-red-500 mb-4 text-sm px-5 py-3 rounded-md inline-block">Logout</a>
        </div>
        <div class="flex gap-3 justify-start">   
        <div class="w-10 h-10 rounded-md rounded-md overflow-hidden ">
            <a  class="" href="/profile/upload">

                <img class="h-full w-full  object-cover" src="/images/uploads/<%= user.profilepic %>" alt="">
            </a>
        </div>
        <h1 class="text-3xl mb-3 "> <span class="font-light">Hello</span> , <%= user.name %></h1>
        </div>
        <a href="/friends">
                
            <h1 class="text-zinc-500">friends( <%= user.friends.length %> )</h1>
        </a>
            <h5>you can create a new post</h5>
        <form action="/post" method="post">
            <textarea placeholder="What's on your mind?" name="content" class=" block resize-none bg-transparent border-3 border-zinc-500 mt-4 w-1/3 outline-none p-3 rounded-md"></textarea>
            <input type="submit" class="px-5 py-3 bg-blue-500 block mt-3 w-40 rounded-md" value="create new post">
        </form>
        <div class="mt-15  w-full flex justify-start">

            <div class="w-full">
                <div class="flex  ">
                    
                    <h3 class="text-zinc-400">Your's post</h3>
                    
                    <a class="mx-7 text-red-500" href="/allpost">All posts</a>
                </div>
                <% user.post.reverse().forEach((post) => { %>
                    <div class="postcontainer mt-3 p-3 w-1/3 border-1 mb-4 border-zinc-800 rounded-md bg-zinc-700">
                        <h4 class="text-blue-500 mb-1">@<%= user.username %></h4>
                        <p class="tracking-tight text-sm"><%= post.content %></p>
                        <small class="inline-block mt-3"><%= post.likes.length %> likes</small>
                        <div   div class="btn flex gap-10 mt-1">
                            <a class="text-blue-500" href="/likes/<%= post._id%>">
                                <%= post.likes.indexOf(user._id) === -1 ? "like" : "Unlike" %>
                            </a>
                            <a href="/edit/<%= post._id%>" class="text-zinc-400">Edit</a>
                            <a href="/delete/<%= post._id%>" class="text-yellow-400"> Delete</a>
                        </div>
                    </div>
                <% }) %>
            </div>
            
            <div class="messages inline-block w-1/3  bg-zinc-700 rounded-md">
                <h1 class="text-3xl algin-center text-blue-500  px-10 py-4">Friend request</h1>

                    <%user.messages.forEach((msg) => {%>
                        <div class="message p-3">
                            <div class="flex gap-3 px-10 py-3">
                                <img style="border-radius: 50%;" class="object-cover h-13 w-13 bg-red-500" src="/images/uploads/<%= requser.profilepic%>" alt="">
                                <h1 style="transform: translateY(10px);" class="text-xl"><%= requser.username%></h1>
                                
                            </div>
                            <div class="btn flex gap-8 px-11">
                                <a href="/request/<%= requser._id%>">
                                    
                                    <button class="text-xl bg-blue-500 px-5 py-3 rounded-md">Accept</button>
                                </a>
                                <button class="text-xl bg-transparent border-1 border-zinc-400 px-5 py-3 rounded-md">Cancel</button>
                            </div>
                        </div> 
                    <% })%>



            </div>
        </div>
    </div>

</body>
</html>