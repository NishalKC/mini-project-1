<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a href="/profile" class="text-xl text-red-500 mb-4 flex justify-end w-full" >
            <img src="/images//uploads/<%= friend.profilepic%>" alt="" class="  w-13 h-13" style="border-radius: 50%;">
        </a>
        <a href="/allpost" class="text-xl text-red-500 mb-6 inline-block">Go Back to post</a>
        

        <center>

            <div class="detail">
                <img style="border-radius: 50%;" class="h-50 w-50" src="/images/uploads/<%= user.profilepic%>" alt="">
                <h1 class="text-3xl mt-3 ">Username : <span class=" text-blue-500"><%= user.username%></span></h1>
                <h1>Age : <span class="mt-1 text-blue-500"><%= user.age%></span></h1>
                    <a href="/friendreq/<%= user._id%>" id="req-btn" class="bg-blue-500 px-5 py-3 mt-7 inline-block rounded-md">
                        <%= friend.friends.some(id => id.toString() === user._id.toString()   )? "Friends": "Add Friend"%>
                    </a>
            </div>
        </center>
        <div class=" mt-15 inline-block w-full">
            <h1 class="text-3xl">Posts</h1>
            <% posts.forEach((post) => {%>
                
                <div class="postcontainer mt-3 p-3 w-1/3 border-1 mb-4 border-zinc-800 rounded-md bg-zinc-700">
                    <div class="flex gap-3 mb-4 ">
                        <img style="border-radius: 50%;" class="w-8 h-8 " src="/images/uploads/<%= user.profilepic%>" alt="">
                        <h4 class="text-blue-500 mb-1 " style="transform: translateY(5px);">@<%= user.username %></h4>
                    </div>
                    <p class="tracking-tight text-sm"><%= post.content %></p>
                    <small class="inline-block mt-3"><%= post.likes.length %> likes</small>
                    <div   div class="btn flex gap-7 mt-1">
                        <a class="text-blue-500" href="/likes/<%= post._id %>">
                                <%= post.likes.some(id => id.toString() === inspecteduser.userid.toString())? "Unlike" : "Like" %>
                                
                                
                        </a>
                        <a href="/edit/<%= post._id%>" class="text-zinc-400">Edit</a>
                    </div>
                </div>
                <% }) %>
        </div>


        </div>
    </div>
</body>
</html>